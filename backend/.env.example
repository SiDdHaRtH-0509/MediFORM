PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mediform
JWT_SECRET=replace_with_64_char_random_hex_secret
ENCRYPTION_KEY=replace_with_32_byte_aes_256_encryption_key
OTP_SERVER_SECRET=replace_with_random_otp_hmac_secret
MAX_JSON_BODY_SIZE=10mb
QR_SHARE_TTL_MINUTES=120
PIN_MAX_ATTEMPTS=5
APP_PUBLIC_URL=https://mediform.health
CORS_ORIGIN=https://mediform.health
SEED_DEMO_DATA=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediFORM Dispatch <noreply@mediform.health>


