{
  "expo": {
    "name": "MediFORM",
    "slug": "mediform",
    "version": "2.0.0",
    "scheme": "mediform",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C8C"
    },
    "ios": {
      "bundleIdentifier": "com.colintech.mediform",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MediFORM needs camera access to scan secure patient transfer QR codes.",
        "NSLocationWhenInUseUsageDescription": "MediFORM uses GPS location to track live patient/ambulance coordinates and ETA during hospital transfers.",
        "LSApplicationQueriesSchemes": ["tel", "sms", "mailto", "whatsapp"]
      }
    },
    "android": {
      "package": "com.colintech.mediform",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A5C8C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CALL_PHONE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mediform.health",
              "pathPrefix": "/handoff"
            },
            {
              "scheme": "mediform",
              "host": "handoff"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MediFORM needs camera access to scan a secure transfer QR code."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MediFORM needs location access to pinpoint patient & ambulance coordinates during inter-hospital transfers."
        }
      ]
    ]
  }
}
